# ===== 应用配置 =====
APP_ENV=dev
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 数据库 =====
# 本地默认 SQLite，零配置；生产可换成 MySQL
# DATABASE_URL=sqlite:///./moneymate.db
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/moneymate

# ===== 缓存（可选）=====
# 留空 = 使用内存缓存（开发零依赖）；配置后使用 Redis
# REDIS_URL=redis://localhost:6379/0

# ===== LLM（AI 助手，可选）=====
# 不配置则 AI 记账/智能分类/月度分析返回 503，其余功能正常
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== 演示数据 =====
# 留空 = 空数据库时自动生成 demo 账号；true = 对已有数据的库也强制生成
SEED_DEMO_DATA=

# ===== CORS =====
# 开发环境（APP_ENV=dev）允许所有来源；生产环境必须指定域名（逗号分隔）
# CORS_ORIGINS=https://money-mate.example.com,https://www.example.com
CORS_ORIGINS=
